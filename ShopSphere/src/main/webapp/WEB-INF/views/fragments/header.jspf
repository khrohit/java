<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<fmt:setLocale value="${empty param.lang ? 'en' : param.lang}" />
<fmt:setBundle basename="i18n.messages" var="msg" />
<header class="topbar">
    <div class="nav-wrap">
        <a class="brand" href="${pageContext.request.contextPath}/">shop<span>sphere</span><i>.</i></a>
        <nav class="main-nav">
            <a href="${pageContext.request.contextPath}/products"><fmt:message key="nav.products" bundle="${msg}" /></a>
            <c:if test="${not empty sessionScope.shopUser}">
                <a href="${pageContext.request.contextPath}/orders"><fmt:message key="nav.orders" bundle="${msg}" /></a>
                <a href="${pageContext.request.contextPath}/wishlist">Saved</a>
                <a href="${pageContext.request.contextPath}/profile">Account</a>
            </c:if>
            <c:if test="${sessionScope.shopUser.admin}">
                <a href="${pageContext.request.contextPath}/admin"><fmt:message key="nav.admin" bundle="${msg}" /></a>
            </c:if>
        </nav>
        <form class="nav-search" action="${pageContext.request.contextPath}/products" method="get">
            <span aria-hidden="true">⌕</span><input name="q" placeholder="Search the store" value="${fn:escapeXml(param.q)}" aria-label="Search products">
        </form>
        <div class="nav-actions">
            <c:choose>
                <c:when test="${not empty sessionScope.shopUser}">
                    <a class="icon-link" href="${pageContext.request.contextPath}/cart"><fmt:message key="nav.cart" bundle="${msg}" /><span class="bag-icon">↗</span></a>
                    <span class="user-greeting">Hi, <c:out value="${sessionScope.shopUser.name}"/></span>
                    <form action="${pageContext.request.contextPath}/logout" method="post"><button class="text-button"><fmt:message key="nav.logout" bundle="${msg}" /></button></form>
                </c:when>
                <c:otherwise>
                    <a href="${pageContext.request.contextPath}/login"><fmt:message key="nav.login" bundle="${msg}" /></a>
                    <a class="button button-small" href="${pageContext.request.contextPath}/register"><fmt:message key="nav.register" bundle="${msg}" /></a>
                </c:otherwise>
            </c:choose>
        </div>
    </div>
</header>

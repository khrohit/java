<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Your bag — ShopSphere</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/site.css"></head><body>
<%@ include file="fragments/header.jspf" %><main class="shell page-shell"><div class="page-intro"><span class="eyebrow">Your saved finds</span><h1>Your bag.</h1><p>A good choice, ready when you are.</p></div><c:if test="${not empty error}"><div class="alert alert-error"><c:out value="${error}"/></div></c:if><c:if test="${not empty notice}"><div class="alert alert-success"><c:out value="${notice}"/></div></c:if>
<c:choose><c:when test="${empty items}"><div class="empty-state"><div class="empty-icon">◌</div><h2>Your bag is taking a breather.</h2><p>Find something useful and it will be waiting here.</p><a class="button button-dark" href="${pageContext.request.contextPath}/products">Explore the shop <span>↗</span></a></div></c:when><c:otherwise><div class="cart-layout"><div class="cart-items"><c:forEach var="item" items="${items}"><article class="cart-row"><a class="cart-thumb" href="${pageContext.request.contextPath}/product?id=${item.product.productId}"><img src="${item.product.imageUrl}" alt="${item.product.name}"></a><div class="cart-product"><span class="eyebrow"><c:out value="${item.product.brand}"/></span><a href="${pageContext.request.contextPath}/product?id=${item.product.productId}"><c:out value="${item.product.name}"/></a><span class="muted">In stock: <c:out value="${item.product.stock}"/></span></div><form class="quantity-form" method="post" action="${pageContext.request.contextPath}/cart"><input type="hidden" name="action" value="update"><input type="hidden" name="productId" value="${item.product.productId}"><input type="number" name="quantity" min="0" max="${item.product.stock}" value="${item.quantity}" aria-label="Quantity"><button class="text-button" type="submit">Update</button></form><strong class="cart-line-total"><fmt:formatNumber value="${item.lineTotal}" type="currency" currencyCode="INR"/></strong><form method="post" action="${pageContext.request.contextPath}/cart"><input type="hidden" name="action" value="remove"><input type="hidden" name="productId" value="${item.product.productId}"><button class="remove-button" type="submit" aria-label="Remove product">×</button></form></article></c:forEach></div><aside class="summary-card"><span class="eyebrow">The little details</span><h2>Order summary</h2><div class="summary-line"><span>Subtotal</span><strong><fmt:formatNumber value="${total}" type="currency" currencyCode="INR"/></strong></div><div class="summary-line"><span>Shipping</span><strong>On us</strong></div><div class="summary-total"><span>Total</span><strong><fmt:formatNumber value="${total}" type="currency" currencyCode="INR"/></strong></div><a class="button button-dark button-full" href="${pageContext.request.contextPath}/checkout">Continue to checkout <span>↗</span></a><p class="summary-note">Taxes included. Mock payment for this student demo.</p></aside></div></c:otherwise></c:choose></main><%@ include file="fragments/footer.jspf" %></body></html>

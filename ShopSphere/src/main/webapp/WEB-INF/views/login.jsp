<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Sign in — ShopSphere</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/site.css"></head><body>
<%@ include file="fragments/header.jspf" %><main class="auth-shell"><div class="auth-card"><span class="eyebrow">Welcome back</span><h1>Good to see you.</h1><p>Sign in to pick up where you left off.</p><c:if test="${not empty error}"><div class="alert alert-error"><c:out value="${error}"/></div></c:if><form method="post" action="${pageContext.request.contextPath}/login" class="stack-form"><label>Email address<input type="email" name="email" autocomplete="email" required></label><label>Password<input type="password" name="password" autocomplete="current-password" required></label><button class="button button-dark button-full" type="submit">Sign in <span>↗</span></button></form><p class="auth-switch">New to ShopSphere? <a href="${pageContext.request.contextPath}/register">Create an account</a></p><p class="auth-footnote">Admin? Sign in with an account promoted to ADMIN by the database owner.</p></div></main><%@ include file="fragments/footer.jspf" %></body></html>

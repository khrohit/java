<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Checkout — ShopSphere</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/site.css"></head><body>
<%@ include file="fragments/header.jspf" %><main class="shell page-shell"><div class="page-intro"><span class="eyebrow">One last step</span><h1>Make it yours.</h1><p>Review your bag and place a demo order.</p></div><c:if test="${not empty error}"><div class="alert alert-error"><c:out value="${error}"/></div></c:if><c:choose><c:when test="${empty items}"><div class="empty-state"><h2>Your bag is empty.</h2><a class="button button-dark" href="${pageContext.request.contextPath}/products">Back to shop</a></div></c:when><c:otherwise>
<div class="checkout-layout"><section class="checkout-panel"><span class="eyebrow">Delivery and payment</span><h2>Where should we send it?</h2><p>This project uses a simulated payment. No card details are collected.</p><form action="${pageContext.request.contextPath}/checkout" method="post" class="stack-form"><label>Address<input type="text" name="addressLine" maxlength="255" autocomplete="street-address" required></label><label>City<input type="text" name="city" maxlength="100" autocomplete="address-level2" required></label><div class="split-fields"><label>State<input type="text" name="state" maxlength="100" autocomplete="address-level1" required></label><label>PIN code<input type="text" name="pincode" maxlength="20" autocomplete="postal-code" required></label></div><label>Coupon code <input type="text" name="coupon" placeholder="Try WELCOME10"></label><div class="mock-payment"><span class="mock-icon">✓</span><div><strong>Demo payment</strong><p>Marked as paid when the order is placed.</p></div></div><button class="button button-dark button-full" type="submit">Place order · <fmt:formatNumber value="${total}" type="currency" currencyCode="INR"/></button></form></section><aside class="summary-card"><span class="eyebrow">Your items</span><c:forEach var="item" items="${items}"><div class="summary-line"><span><c:out value="${item.product.name}"/> × <c:out value="${item.quantity}"/></span><strong><fmt:formatNumber value="${item.lineTotal}" type="currency" currencyCode="INR"/></strong></div></c:forEach><div class="summary-total"><span>Subtotal</span><strong><fmt:formatNumber value="${total}" type="currency" currencyCode="INR"/></strong></div><p class="summary-note">Coupon and final total are checked on the server.</p></aside></div>
</c:otherwise></c:choose></main><%@ include file="fragments/footer.jspf" %></body></html>

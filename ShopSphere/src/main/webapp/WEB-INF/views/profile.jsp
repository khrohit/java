<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Your profile — ShopSphere</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/site.css"></head><body><%@ include file="fragments/header.jspf" %><main class="auth-shell"><section class="auth-card"><span class="eyebrow">Your ShopSphere account</span><h1>Your details.</h1><c:if test="${not empty error}"><div class="alert alert-error"><c:out value="${error}"/></div></c:if><c:if test="${not empty notice}"><div class="alert alert-success"><c:out value="${notice}"/></div></c:if><form method="post" action="${pageContext.request.contextPath}/profile" class="stack-form"><label>Name<input name="name" value="${sessionScope.shopUser.name}" required maxlength="120"></label><label>Email address<input type="email" value="${sessionScope.shopUser.email}" readonly></label><label>Mobile number<input type="tel" name="mobile" value="${sessionScope.shopUser.mobile}" maxlength="30"></label><button class="button button-dark button-full" type="submit">Save details</button></form><p class="auth-switch"><a href="${pageContext.request.contextPath}/wishlist">View your wishlist</a></p></section></main><%@ include file="fragments/footer.jspf" %></body></html>

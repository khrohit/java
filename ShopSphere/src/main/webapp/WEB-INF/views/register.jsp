<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Create account — ShopSphere</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/site.css"></head><body>
<%@ include file="fragments/header.jspf" %><main class="auth-shell"><div class="auth-card"><span class="eyebrow">Join the good finds club</span><h1>Make it yours.</h1><p>Create an account to save your bag and keep track of orders.</p><c:if test="${not empty error}"><div class="alert alert-error"><c:out value="${error}"/></div></c:if><form method="post" action="${pageContext.request.contextPath}/register" class="stack-form"><label>Your name<input type="text" name="name" autocomplete="name" required minlength="2" maxlength="120"></label><label>Email address<input type="email" name="email" autocomplete="email" required></label><label>Mobile number<input type="tel" name="mobile" autocomplete="tel" maxlength="30"></label><label>Password<input type="password" name="password" autocomplete="new-password" required minlength="8"></label><button class="button button-dark button-full" type="submit">Create account <span>↗</span></button></form><p class="auth-switch">Already have an account? <a href="${pageContext.request.contextPath}/login">Sign in</a></p></div></main><%@ include file="fragments/footer.jspf" %></body></html>

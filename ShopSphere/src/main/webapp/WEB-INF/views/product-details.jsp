<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><c:out value="${product.name}"/> — ShopSphere</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/site.css"></head><body>
<%@ include file="fragments/header.jspf" %><main class="shell page-shell"><a class="back-link" href="${pageContext.request.contextPath}/products">← Back to the collection</a><div class="detail-layout"><div class="detail-image"><img src="${fn:escapeXml(product.imageUrl)}" alt="${fn:escapeXml(product.name)}"></div><div class="detail-copy"><span class="eyebrow"><c:out value="${product.categoryName}"/> · <c:out value="${product.brand}"/></span><h1><c:out value="${product.name}"/></h1><div class="price-line detail-price"><strong><fmt:formatNumber value="${product.salePrice}" type="currency" currencyCode="INR"/></strong><c:if test="${product.discount gt 0}"><del><fmt:formatNumber value="${product.price}" type="currency" currencyCode="INR"/></del><span class="discount-pill">Save <fmt:formatNumber value="${product.discount}" maxFractionDigits="0"/>%</span></c:if></div><p class="detail-description"><c:out value="${product.description}"/></p><p class="stock-note"><span class="note-dot"></span><c:choose><c:when test="${product.stock gt 0}"><c:out value="${product.stock}"/> available to ship</c:when><c:otherwise>Currently out of stock</c:otherwise></c:choose></p><form action="${pageContext.request.contextPath}/cart" method="post" class="detail-add"><input type="hidden" name="action" value="add"><input type="hidden" name="productId" value="${product.productId}"><label>Quantity <input type="number" name="quantity" value="1" min="1" max="${product.stock}" ${product.stock le 0 ? 'disabled' : ''}></label><button class="button button-dark" type="submit" ${product.stock le 0 ? 'disabled' : ''}>Add to bag <span>↗</span></button></form><form method="post" action="${pageContext.request.contextPath}/wishlist" class="save-form"><input type="hidden" name="productId" value="${product.productId}"><button class="text-button" type="submit">♡ Save to wishlist</button></form><div class="detail-promise"><span>✓ Easy returns</span><span>✓ Secure checkout</span><span>✓ Mock payment for demo</span></div></div></div><section class="admin-section"><span class="eyebrow">Customer notes</span><h2>Reviews</h2><c:if test="${not empty reviewNotice}"><div class="alert alert-success"><c:out value="${reviewNotice}"/></div></c:if><c:forEach var="review" items="${reviews}"><article class="review-card"><strong><c:out value="${review.customerName}"/></strong><span><c:out value="${review.rating}"/> / 5</span><p><c:out value="${review.text}"/></p><small><fmt:formatDate value="${review.createdAt}" pattern="dd MMM yyyy"/></small></article></c:forEach><c:if test="${empty reviews}"><p>No reviews yet. Be the first to review this item.</p></c:if><c:if test="${not empty sessionScope.shopUser}"><form method="post" action="${pageContext.request.contextPath}/review" class="admin-form"><input type="hidden" name="productId" value="${product.productId}"><label>Rating<select name="rating"><option value="5">5 — Excellent</option><option value="4">4 — Good</option><option value="3">3 — Okay</option><option value="2">2 — Poor</option><option value="1">1 — Bad</option></select></label><label class="wide">Your review<textarea name="reviewText" maxlength="1000" required></textarea></label><button class="button button-dark">Submit review</button></form></c:if></section></main><%@ include file="fragments/footer.jspf" %></body></html>

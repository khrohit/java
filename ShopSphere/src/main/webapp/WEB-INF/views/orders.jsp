<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Your orders — ShopSphere</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/site.css"></head><body><%@ include file="fragments/header.jspf" %><main class="shell page-shell"><div class="page-intro"><span class="eyebrow">The good things you chose</span><h1>Your orders.</h1></div><c:choose><c:when test="${empty orders}"><div class="empty-state"><h2>No orders yet.</h2><p>Your next favourite is out there.</p><a class="button button-dark" href="${pageContext.request.contextPath}/products">Shop the collection</a></div></c:when><c:otherwise><div class="table-wrap"><table class="data-table"><thead><tr><th>Order</th><th>Placed</th><th>Total</th><th>Payment</th><th>Status</th></tr></thead><tbody><c:forEach var="order" items="${orders}"><tr><td>#<c:out value="${order.orderId}"/></td><td><fmt:formatDate value="${order.createdAt}" pattern="dd MMM yyyy, HH:mm"/></td><td><fmt:formatNumber value="${order.totalAmount}" type="currency" currencyCode="INR"/></td><td><span class="status-badge"><c:out value="${order.paymentStatus}"/></span></td><td><span class="status-badge"><c:out value="${order.orderStatus}"/></span></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></main><%@ include file="fragments/footer.jspf" %></body></html>

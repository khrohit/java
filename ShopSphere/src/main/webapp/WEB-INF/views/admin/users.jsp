<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Customers — ShopSphere</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/site.css"></head><body><%@ include file="../fragments/header.jspf" %><main class="shell page-shell admin-page"><div class="page-intro"><div><span class="eyebrow">Accounts</span><h1>Customers.</h1></div></div><nav class="admin-nav"><a href="${pageContext.request.contextPath}/admin">Overview</a><a href="${pageContext.request.contextPath}/admin/products">Products</a><a href="${pageContext.request.contextPath}/admin/categories">Categories</a><a href="${pageContext.request.contextPath}/admin/coupons">Coupons</a><a href="${pageContext.request.contextPath}/admin/users">Customers</a><a href="${pageContext.request.contextPath}/admin/orders">Orders</a></nav><section class="admin-section"><div class="table-wrap"><table class="data-table"><thead><tr><th>Name</th><th>Email</th><th>Mobile</th><th>Status</th></tr></thead><tbody><c:forEach var="customer" items="${customers}"><tr><td><c:out value="${customer.name}"/></td><td><c:out value="${customer.email}"/></td><td><c:out value="${customer.mobile}"/></td><td><c:out value="Active"/></td></tr></c:forEach><c:if test="${empty customers}"><tr><td colspan="4">No customers registered yet.</td></tr></c:if></tbody></table></div></section></main><%@ include file="../fragments/footer.jspf" %></body></html>

<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Coupons — ShopSphere</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/site.css"></head><body><%@ include file="../fragments/header.jspf" %><main class="shell page-shell admin-page"><div class="page-intro"><div><span class="eyebrow">Promotions</span><h1>Coupons.</h1></div></div><nav class="admin-nav"><a href="${pageContext.request.contextPath}/admin">Overview</a><a href="${pageContext.request.contextPath}/admin/products">Products</a><a href="${pageContext.request.contextPath}/admin/categories">Categories</a><a href="${pageContext.request.contextPath}/admin/coupons">Coupons</a><a href="${pageContext.request.contextPath}/admin/users">Customers</a><a href="${pageContext.request.contextPath}/admin/orders">Orders</a></nav><c:if test="${not empty notice}"><div class="alert alert-success"><c:out value="${notice}"/></div></c:if><section class="admin-section"><h2>Create coupon</h2><form method="post" class="admin-form"><label>Code<input name="code" pattern="[A-Za-z0-9_-]{3,40}" required></label><label>Type<select name="type"><option value="PERCENT">Percent</option><option value="FIXED">Fixed amount (INR)</option></select></label><label>Discount value<input type="number" name="value" min="0.01" step="0.01" required></label><label>Minimum order (INR)<input type="number" name="minimumOrder" min="0" step="0.01" value="0" required></label><label>Maximum discount (INR)<input type="number" name="maximumDiscount" min="0" step="0.01"></label><label>Expiry date<input type="date" name="expiryDate"></label><button class="button button-dark">Create coupon</button></form></section><section class="admin-section"><h2>Current coupons</h2><div class="table-wrap"><table class="data-table"><thead><tr><th>Code</th><th>Discount</th><th>Minimum</th><th>Expires</th><th>Status</th><th></th></tr></thead><tbody><c:forEach var="coupon" items="${coupons}"><tr><td><c:out value="${coupon.code}"/></td><td><c:out value="${coupon.type}"/> <fmt:formatNumber value="${coupon.value}" minFractionDigits="0" maxFractionDigits="2"/></td><td><fmt:formatNumber value="${coupon.minimumOrder}" type="currency" currencyCode="INR"/></td><td><c:out value="${coupon.expiryDate}"/></td><td><c:out value="${coupon.active ? 'Active' : 'Archived'}"/></td><td><c:if test="${coupon.active}"><form method="post"><input type="hidden" name="action" value="archive"><input type="hidden" name="couponId" value="${coupon.couponId}"><button class="text-button">Archive</button></form></c:if></td></tr></c:forEach></tbody></table></div></section></main><%@ include file="../fragments/footer.jspf" %></body></html>

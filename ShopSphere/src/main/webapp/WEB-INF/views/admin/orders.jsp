<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Orders — ShopSphere Admin</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/site.css"></head><body><%@ include file="../fragments/header.jspf" %><main class="shell page-shell admin-page"><div class="page-intro"><div><span class="eyebrow">Customer activity</span><h1>Orders.</h1></div></div><nav class="admin-nav"><a href="${pageContext.request.contextPath}/admin">Overview</a><a href="${pageContext.request.contextPath}/admin/products">Products</a><a href="${pageContext.request.contextPath}/admin/categories">Categories</a><a href="${pageContext.request.contextPath}/admin/coupons">Coupons</a><a href="${pageContext.request.contextPath}/admin/users">Customers</a><a href="${pageContext.request.contextPath}/admin/orders">Orders</a></nav><section class="admin-section"><div class="table-wrap"><table class="data-table"><thead><tr><th>Order</th><th>Placed</th><th>Total</th><th>Payment</th><th>Order status</th><th>Update</th></tr></thead><tbody><c:forEach var="order" items="${orders}"><tr><td>#<c:out value="${order.orderId}"/></td><td><fmt:formatDate value="${order.createdAt}" pattern="dd MMM yyyy, HH:mm"/></td><td><fmt:formatNumber value="${order.totalAmount}" type="currency" currencyCode="INR"/></td><td><c:out value="${order.paymentStatus}"/></td><td><span class="status-badge"><c:out value="${order.orderStatus}"/></span></td><td><form method="post" action="${pageContext.request.contextPath}/admin/orders" class="inline-form"><input type="hidden" name="orderId" value="${order.orderId}"><select name="status"><option>PLACED</option><option>PROCESSING</option><option>SHIPPED</option><option>DELIVERED</option><option>CANCELLED</option></select><button class="button button-dark" type="submit">Save</button></form></td></tr></c:forEach><c:if test="${empty orders}"><tr><td colspan="6">No orders yet.</td></tr></c:if></tbody></table></div></section></main><%@ include file="../fragments/footer.jspf" %></body></html>

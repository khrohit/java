<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Admin — ShopSphere</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/site.css"></head><body><%@ include file="../fragments/header.jspf" %><main class="shell page-shell admin-page"><div class="page-intro"><div><span class="eyebrow">ShopSphere operations</span><h1>Good morning, <c:out value="${sessionScope.shopUser.name}"/>.</h1></div><span class="status-badge">ADMIN</span></div><nav class="admin-nav"><a href="${pageContext.request.contextPath}/admin">Overview</a><a href="${pageContext.request.contextPath}/admin/products">Products</a><a href="${pageContext.request.contextPath}/admin/categories">Categories</a><a href="${pageContext.request.contextPath}/admin/coupons">Coupons</a><a href="${pageContext.request.contextPath}/admin/users">Customers</a><a href="${pageContext.request.contextPath}/admin/orders">Orders</a></nav><div class="stat-grid"><div class="stat-card"><span>Live products</span><strong><c:out value="${counts.products}"/></strong></div><div class="stat-card"><span>Customers</span><strong><c:out value="${counts.customers}"/></strong></div><div class="stat-card"><span>Orders</span><strong><c:out value="${counts.orders}"/></strong></div><div class="stat-card"><span>Low stock</span><strong><c:out value="${counts.lowStock}"/></strong></div></div><section class="admin-section"><span class="eyebrow">A quick note</span><h2>Everything in one place.</h2><p>Manage the product catalogue and keep an eye on order status. Inventory is reduced when a customer places a demo order.</p><a class="button button-dark" href="${pageContext.request.contextPath}/admin/products">Manage products <span>↗</span></a></section></main><%@ include file="../fragments/footer.jspf" %></body></html>

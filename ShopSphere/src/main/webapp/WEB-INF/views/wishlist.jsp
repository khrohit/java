<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="shop" tagdir="/WEB-INF/tags" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Your wishlist — ShopSphere</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/site.css"></head><body><%@ include file="fragments/header.jspf" %><main class="shell page-shell"><div class="page-intro"><span class="eyebrow">Saved for later</span><h1>Your wishlist.</h1></div><c:if test="${not empty notice}"><div class="alert alert-success"><c:out value="${notice}"/></div></c:if><c:choose><c:when test="${empty products}"><div class="empty-state"><h2>A place for the maybe-laters.</h2><p>Save the things you like and come back when you're ready.</p><a class="button button-dark" href="${pageContext.request.contextPath}/products">Browse products</a></div></c:when><c:otherwise><div class="product-grid"><c:forEach var="product" items="${products}"><div class="wishlist-card"><shop:productCard product="${product}"/><form class="wishlist-remove" method="post" action="${pageContext.request.contextPath}/wishlist"><input type="hidden" name="action" value="remove"><input type="hidden" name="productId" value="${product.productId}"><button class="text-button" type="submit">Remove from saved items</button></form></div></c:forEach></div></c:otherwise></c:choose></main><%@ include file="fragments/footer.jspf" %></body></html>
